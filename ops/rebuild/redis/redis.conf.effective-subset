# Subset of /etc/redis/redis.conf (Ubuntu 24.04 redis 7.0.15 defaults for everything else).
bind 127.0.0.1 172.17.0.1
protected-mode yes
port 6379
timeout 0
tcp-keepalive 300
daemonize yes
dbfilename dump.rdb
dir /var/lib/redis
requirepass ${REDIS_PASSWORD}
appendonly yes
maxmemory 256mb
maxmemory-policy noeviction
