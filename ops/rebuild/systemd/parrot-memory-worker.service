[Unit]
Description=Personal Parrot memory extraction worker (out-of-band, no deadline)
After=redis-server.service
Requires=redis-server.service

[Service]
User=parrot
EnvironmentFile=/home/parrot/parrot/.env
WorkingDirectory=/home/parrot/parrot
ExecStart=/home/parrot/venv/bin/python /home/parrot/parrot/memory_worker.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
