[Unit]
Description=Loro Panel - Personal Parrot read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parrot
Group=parrot
WorkingDirectory=/home/parrot/dashboard
EnvironmentFile=/home/parrot/dashboard/.env
ExecStart=/usr/bin/python3 /home/parrot/dashboard/app.py
Restart=always
RestartSec=3
# Resource guards: the dashboard must never compete with live calls.
MemoryHigh=150M
MemoryMax=250M
CPUWeight=50
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
